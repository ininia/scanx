package ui

// Icon renders a stroke icon (24×24 grid, Lucide-style paths drawn for
// scanX). Icons are decorative (aria-hidden); the text next to them carries
// the meaning.
templ Icon(name string) {
	<svg class={ "icon", "i-" + name } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "home":
				<path d="M3 10.5 12 3l9 7.5"></path>
				<path d="M5 9.5V21h5v-6h4v6h5V9.5"></path>
			case "folder":
				<path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h5l2 2.5h8A1.5 1.5 0 0 1 21 9v9.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z"></path>
			case "bell":
				<path d="M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15z"></path>
				<path d="M10 20a2 2 0 0 0 4 0"></path>
			case "users":
				<circle cx="9" cy="8" r="3.5"></circle>
				<path d="M2.5 20a6.5 6.5 0 0 1 13 0"></path>
				<path d="M16 4.5a3.5 3.5 0 0 1 0 7"></path>
				<path d="M18 14a5.5 5.5 0 0 1 3.5 6"></path>
			case "key":
				<circle cx="7.5" cy="15.5" r="4.5"></circle>
				<path d="m11 12 9-9"></path>
				<path d="m16 7 3 3"></path>
				<path d="m14 9 2 2"></path>
			case "file":
				<path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8z"></path>
				<path d="M14 3v5h5"></path>
				<path d="M8.5 13h7M8.5 17h5"></path>
			case "settings":
				<circle cx="12" cy="12" r="3"></circle>
				<path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path>
			case "search":
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m20 20-3.5-3.5"></path>
			case "globe":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M3 12h18"></path>
				<path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z"></path>
			case "chevron-down":
				<path d="m6 9 6 6 6-6"></path>
			case "chevron-right":
				<path d="m9 6 6 6-6 6"></path>
			case "chevrons-left":
				<path d="m11 17-5-5 5-5"></path>
				<path d="m18 17-5-5 5-5"></path>
			case "shield":
				<path d="M12 3 4.5 6v5.5c0 4.5 3.2 8.3 7.5 9.5 4.3-1.2 7.5-5 7.5-9.5V6z"></path>
			case "shield-check":
				<path d="M12 3 4.5 6v5.5c0 4.5 3.2 8.3 7.5 9.5 4.3-1.2 7.5-5 7.5-9.5V6z"></path>
				<path d="m8.5 12 2.5 2.5 4.5-5"></path>
			case "badge-check":
				<path d="M12 2.5l2.3 1.7 2.9-.2.9 2.7 2.4 1.6-.9 2.7.9 2.7-2.4 1.6-.9 2.7-2.9-.2L12 19.5l-2.3-1.7-2.9.2-.9-2.7-2.4-1.6.9-2.7-.9-2.7 2.4-1.6.9-2.7 2.9.2z"></path>
				<path d="m8.5 11 2.5 2.5 4.5-5"></path>
			case "alert-triangle":
				<path d="M10.3 4.2 2.6 17.5A2 2 0 0 0 4.3 20.5h15.4a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z"></path>
				<path d="M12 9.5v4M12 17h.01"></path>
			case "alert-circle":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 8v4.5M12 16h.01"></path>
			case "activity":
				<path d="M3 12h4l3-8 4 16 3-8h4"></path>
			case "arrow-right":
				<path d="M5 12h14M13 6l6 6-6 6"></path>
			case "arrow-up":
				<path d="M12 19V5M6 11l6-6 6 6"></path>
			case "arrow-down":
				<path d="M12 5v14M6 13l6 6 6-6"></path>
			case "copy":
				<rect x="8" y="8" width="12" height="12" rx="2"></rect>
				<path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8"></path>
			case "more":
				<circle cx="5" cy="12" r="1.2"></circle>
				<circle cx="12" cy="12" r="1.2"></circle>
				<circle cx="19" cy="12" r="1.2"></circle>
			case "external":
				<path d="M14 4h6v6"></path>
				<path d="M20 4 11 13"></path>
				<path d="M18 14v5.5a1.5 1.5 0 0 1-1.5 1.5h-12A1.5 1.5 0 0 1 3 19.5v-12A1.5 1.5 0 0 1 4.5 6H10"></path>
			case "box":
				<path d="m12 2.5 8.5 4.75v9.5L12 21.5l-8.5-4.75v-9.5z"></path>
				<path d="m3.5 7.25 8.5 4.75 8.5-4.75"></path>
				<path d="M12 12v9.5"></path>
			case "git-branch":
				<circle cx="6" cy="5" r="2"></circle>
				<circle cx="6" cy="19" r="2"></circle>
				<circle cx="18" cy="8" r="2"></circle>
				<path d="M6 7v10"></path>
				<path d="M18 10c0 4-6 3-11.5 7.5"></path>
			case "filter":
				<path d="M3 4.5h18l-7 8.5v6l-4 2v-8z"></path>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "check":
				<path d="m5 12.5 4.5 4.5L19 7"></path>
			case "x":
				<path d="M6 6l12 12M18 6 6 18"></path>
			case "building":
				<rect x="4" y="3" width="11" height="18" rx="1"></rect>
				<path d="M15 9h4.5a.5.5 0 0 1 .5.5V21h-5"></path>
				<path d="M7.5 7h4M7.5 11h4M7.5 15h4M9.5 21v-3"></path>
			case "logout":
				<path d="M15 4h3.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H15"></path>
				<path d="M10 16.5 14.5 12 10 7.5M14.5 12H4"></path>
			case "user":
				<circle cx="12" cy="8" r="4"></circle>
				<path d="M4 21a8 8 0 0 1 16 0"></path>
			case "github":
				<path stroke="none" fill="currentColor" d="M12 2.2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 3 .8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A10 10 0 0 0 12 2.2z"></path>
			case "gitlab":
				<path stroke="none" fill="currentColor" d="m12 21.4 3.7-11.3H8.3zM12 21.4 8.3 10.1H3.1zM3.1 10.1l-1.1 3.5c-.1.3 0 .7.3.9L12 21.4zM3.1 10.1h5.2L6.1 3.2c-.1-.4-.6-.4-.7 0zM12 21.4l3.7-11.3h5.2zM20.9 10.1l1.1 3.5c.1.3 0 .7-.3.9L12 21.4zM20.9 10.1h-5.2l2.2-6.9c.1-.4.6-.4.7 0z"></path>
			case "bitbucket":
				<path stroke="none" fill="currentColor" d="M2.7 3.1a.7.7 0 0 0-.7.8l2.9 17.3c.1.4.4.7.8.7h12.9c.3 0 .6-.2.6-.5L22 3.9a.7.7 0 0 0-.7-.8zm11.4 12.4h-4.2l-1.1-5.9h6.4z"></path>
			case "gitea":
				<path d="M4 7h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"></path>
				<path d="M17 9h1.5a2.5 2.5 0 0 1 0 5H17"></path>
			default:
				<circle cx="12" cy="12" r="9"></circle>
		}
	</svg>
}

// ProviderIcon picks the icon for a Git provider.
func ProviderIcon(provider string) string {
	switch provider {
	case "github", "gitlab", "bitbucket", "gitea":
		return provider
	}
	return "git-branch"
}
