package ui

templ head(p *Page) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="color-scheme" content="dark light"/>
	<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowScriptTags":false,"allowEval":false}'/>
	<title>
		if p.Title != "" {
			{ p.Title } · { p.Instance }
		} else {
			{ p.Instance }
		}
	</title>
	<link rel="icon" href="/static/img/scanx-mark.svg" type="image/svg+xml"/>
	<link rel="stylesheet" href={ Asset("css/tokens.css") }/>
	<link rel="stylesheet" href={ Asset("css/app.css") }/>
	<link rel="stylesheet" href={ Asset("css/shell.css") }/>
	<script src={ Asset("js/theme.js") }></script>
	<script src={ Asset("js/htmx.min.js") } defer></script>
	<script src={ Asset("js/app.js") } defer></script>
}

templ brand() {
	<a class="brand" href="/" aria-label="scanX">
		<img class="logo logo-dark" src={ Asset("img/scanx-logo.png") } alt="scanX" width="560" height="144"/>
		<img class="logo logo-light" src={ Asset("img/scanx-logo-light.png") } alt="" width="560" height="144"/>
	</a>
}

templ flash(p *Page) {
	if p.Flash != "" {
		<div class={ "alert", p.FlashKind } role="status">{ p.T(p.Flash) }</div>
	}
}

// AuthShell is the centered layout for login, 2FA, setup and invitations.
templ AuthShell(p *Page, wide bool) {
	<!DOCTYPE html>
	<html lang={ p.Lang }>
		<head>
			@head(p)
		</head>
		<body class={ templ.KV("wide", wide) }>
			<div class="theme-corner">@themeToggle(p)</div>
			<main class="auth">
				<div class="auth-card">
					@brand()
					<p class="tagline">{ p.T("app.tagline") }</p>
					@flash(p)
					{ children... }
					<div class="auth-foot">
						<a href={ templ.SafeURL("/lang/" + p.OtherLang() + "?next=" + p.Path) }>{ p.T("lang.switch") }</a>
						<span>scanX { p.Version }</span>
					</div>
				</div>
			</main>
		</body>
	</html>
}

templ navLink(p *Page, key, href, icon, label string) {
	<a href={ templ.SafeURL(href) } class={ templ.KV("active", p.Nav == key) } title={ label }>
		@Icon(icon)
		<span class="nav-label">{ label }</span>
	</a>
}

// AppShell is the signed-in layout: sidebar (org switcher, navigation) and
// top bar (search, notifications, language, theme, account).
templ AppShell(p *Page) {
	<!DOCTYPE html>
	<html lang={ p.Lang }>
		<head>
			@head(p)
		</head>
		<body hx-boost="true">
			<div class="shell">
				<aside class="sidebar">
					<div class="side-head">
						@brand()
						<button type="button" class="icon-btn collapse-btn" data-sidebar-toggle aria-label={ p.T("nav.collapse") } title={ p.T("nav.collapse") }>
							@Icon("chevrons-left")
						</button>
					</div>
					if len(p.Orgs) > 0 {
						<details class="dropdown org-switch no-caret">
							<summary>
								<span class="org-icon">@Icon("building")</span>
								<span class="org-meta">
									if p.Org != nil {
										<strong>{ p.Org.Org.Name }</strong>
										<small>{ p.RoleLabel() }</small>
									} else {
										<strong>{ p.T("nav.choose_org") }</strong>
									}
								</span>
								@Icon("chevron-down")
							</summary>
							<div class="menu">
								for _, o := range p.Orgs {
									<a href={ templ.SafeURL("/o/" + o.Slug) }>{ o.Name } <span class="faint">· { p.T("role." + string(o.Role)) }</span></a>
								}
							</div>
						</details>
					}
					<nav class="nav" aria-label={ p.T("nav.main") }>
						if p.Org != nil {
							@navLink(p, "dashboard", p.OrgURL(""), "home", p.T("nav.dashboard"))
							if p.HasModule("repo") {
								@navLink(p, "projects", p.OrgURL("/projects"), "folder", p.T("nav.projects"))
							}
							if p.HasModule("db") {
								@navLink(p, "databases", p.OrgURL("/databases"), "database", p.T("nav.databases"))
							}
							if p.HasModule("tls") {
								@navLink(p, "domains", p.OrgURL("/domains"), "lock", p.T("nav.domains"))
							}
							@navLink(p, "notifications", p.OrgURL("/notifications"), "bell", p.T("nav.notifications"))
							<span class="sep">{ p.T("nav.organization") }</span>
							@navLink(p, "members", p.OrgURL("/members"), "users", p.T("nav.members"))
							@navLink(p, "tokens", p.OrgURL("/tokens"), "key", p.T("nav.tokens"))
							if p.Can("audit.read") {
								@navLink(p, "audit", p.OrgURL("/audit"), "file", p.T("nav.audit"))
							}
						}
						if p.User != nil && p.User.IsSuperadmin {
							<span class="sep">{ p.T("nav.instance") }</span>
							@navLink(p, "admin", "/admin", "settings", p.T("nav.admin"))
						}
					</nav>
					<div class="side-promo">
						<svg class="promo-art" viewBox="0 0 120 120" aria-hidden="true">
							<defs>
								<linearGradient id="promo-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#00ec93"></stop><stop offset="1" stop-color="#009e5c"></stop></linearGradient>
							</defs>
							<path d="M60 8 104 28v30c0 27-19 48-44 56C35 106 16 85 16 58V28z" fill="none" stroke="url(#promo-g)" stroke-width="3" opacity=".9"></path>
							<path d="M60 24 90 38v20c0 18-13 32-30 38-17-6-30-20-30-38V38z" fill="url(#promo-g)" opacity=".18"></path>
							<path d="m46 60 10 10 19-21" fill="none" stroke="url(#promo-g)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
						<strong>{ p.T("promo.title") }</strong>
						<p>{ p.T("promo.body") }</p>
					</div>
					<div class="sidebar-foot">
						<span>scanX { p.Version }</span>
						<a href="https://github.com/ininia/scanx" rel="noopener noreferrer">@Icon("github") GitHub</a>
					</div>
				</aside>
				<div class="main">
					<header class="topbar">
						if p.Org != nil {
							<form class="top-search" role="search" method="get" action={ templ.SafeURL(p.OrgURL("/search")) }>
								@Icon("search")
								<input type="search" name="q" value={ p.SearchQ } placeholder={ p.T("search.placeholder") } aria-label={ p.T("search.placeholder") } data-search-input autocomplete="off"/>
								<span class="kbd"><kbd>⌘</kbd><kbd>K</kbd></span>
							</form>
						}
						<span class="spacer"></span>
						if p.Org != nil {
							<details class="dropdown right no-caret bell">
								<summary class="icon-btn" aria-label={ p.T("bell.title") } title={ p.T("bell.title") }>
									@Icon("bell")
									if len(p.Problems) > 0 {
										<span class="dot"></span>
									}
								</summary>
								<div class="menu wide">
									<div class="menu-head">{ p.T("bell.title") }</div>
									if len(p.Problems) == 0 {
										<div class="menu-empty">{ p.T("bell.empty") }</div>
									}
									for _, s := range p.Problems {
										<a href={ templ.SafeURL(p.OrgURL("/scans/" + s.ID.String())) } class="bell-item">
											if s.Status == "failed" {
												<span class="bi bad">@Icon("x")</span>
											} else {
												<span class="bi warn">@Icon("alert-triangle")</span>
											}
											<span>
												<strong>{ s.ProjectName }</strong> · { s.Branch }
												<small>
													if s.Status == "failed" {
														{ p.T("bell.scan_failed") }
													} else {
														{ p.T("bell.gate_failed") }
													}
													· { Ago(s.QueuedAt) }
												</small>
											</span>
										</a>
									}
								</div>
							</details>
						}
						<details class="dropdown right no-caret lang">
							<summary>
								@Icon("globe")
								<span>{ p.LangName() }</span>
								@Icon("chevron-down")
							</summary>
							<div class="menu">
								<a href={ templ.SafeURL("/lang/tr?next=" + p.Path) }>Türkçe</a>
								<a href={ templ.SafeURL("/lang/en?next=" + p.Path) }>English</a>
							</div>
						</details>
						@themeToggle(p)
						if p.User != nil {
							<details class="dropdown right no-caret account">
								<summary aria-label={ p.T("nav.account") }>
									<span class="avatar">{ Initials(p.User.Name, p.User.Email) }</span>
									@Icon("chevron-down")
								</summary>
								<div class="menu">
									<div class="menu-head">
										<strong>{ p.User.Name }</strong>
										<small>{ p.User.Email }</small>
									</div>
									<a href="/account">@Icon("user")<span>{ p.T("nav.account") }</span></a>
									<form method="post" action="/logout">
										<input type="hidden" name="csrf_token" value={ p.CSRF }/>
										<button type="submit">@Icon("logout")<span>{ p.T("nav.logout") }</span></button>
									</form>
								</div>
							</details>
						}
					</header>
					<main class="content" id="content">
						@flash(p)
						{ children... }
					</main>
				</div>
			</div>
		</body>
	</html>
}

templ csrf(p *Page) {
	<input type="hidden" name="csrf_token" value={ p.CSRF }/>
}

templ fieldErr(p *Page, f *Form, name string) {
	if f.E(name) != "" {
		<span class="err">{ p.T(f.E(name)) }</span>
	}
}

templ formErr(p *Page, f *Form) {
	if f != nil && f.Error != "" {
		<div class="alert err" role="alert">{ p.T(f.Error) }</div>
	}
}

// ErrorPage renders 403/404/500 pages.
templ ErrorPage(p *Page, code int, titleKey, msgKey string) {
	@AuthShell(p, false) {
		<div class="card">
			<h1>{ p.T(titleKey) }</h1>
			<p class="muted">{ p.T(msgKey) }</p>
			<a class="btn primary" href="/">{ p.T("action.home") }</a>
		</div>
	}
}

// themeToggle switches between the dark and light theme (static/js/app.js);
// the choice is remembered in the browser and applied before first paint
// (static/js/theme.js). Without a choice the OS setting is followed.
templ themeToggle(p *Page) {
	<button type="button" class="theme-toggle" data-theme-toggle aria-label={ p.T("theme.toggle") } title={ p.T("theme.toggle") }>
		<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"></circle><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"></path></g></svg>
		<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.2 14.6A8.5 8.5 0 0 1 9.4 3.8a8.5 8.5 0 1 0 10.8 10.8z"></path></svg>
	</button>
}
