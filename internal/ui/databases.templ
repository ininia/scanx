package ui

import (
	"strconv"
	"strings"

	"github.com/ininia/scanx/internal/dbscan"
	"github.com/ininia/scanx/internal/service"
)

templ dbEngine(engine string) {
	<span class={ "engine", "eng-" + engine }>@Icon("database")<span>{ EngineLabel(engine) }</span></span>
}

templ dbConnStatus(p *Page, status string) {
	<span class={ ConnStatusClass(status) }>
		switch status {
			case "ready":
				@Icon("lock")
			case "rejected", "error":
				@Icon("x")
			default:
				<span class="spinner"></span>
		}
		<span>{ p.T("db.status." + status) }</span>
	</span>
}

// Databases lists the organization's database connections.
templ Databases(p *Page, list []service.DBConnView) {
	@AppShell(p) {
		@pageHero(p, "database", p.T("db.title"), p.T("db.subtitle"), p.T("nav.dashboard"), p.T("db.title")) {
			<a class="btn" href={ templ.SafeURL(p.OrgURL("/databases/rules")) }>@Icon("settings")<span>{ p.T("db.rules") }</span></a>
			if p.Can("project.write") {
				<a class="btn primary glow" href={ templ.SafeURL(p.OrgURL("/databases/new")) }>@Icon("plus")<span>{ p.T("db.new") }</span></a>
			}
		}
		if len(list) == 0 {
			<section class="panel">
				<div class="empty">
					<span class="hero-icon">@Icon("database")</span>
					<h2>{ p.T("db.empty_title") }</h2>
					<p class="muted">{ p.T("db.empty_body") }</p>
					if p.Can("project.write") {
						<a class="btn primary" href={ templ.SafeURL(p.OrgURL("/databases/new")) }>@Icon("plus")<span>{ p.T("db.new") }</span></a>
					}
				</div>
			</section>
			@dbReadOnlyHelp(p, "")
		} else {
			<section class="panel">
				<div class="panel-head">
					<span class="panel-icon">@Icon("database")</span>
					<div><h2>{ p.T("db.count", len(list)) }</h2><p class="muted">{ p.T("db.list_sub") }</p></div>
				</div>
				<div class="tablewrap flat">
					<table class="data">
						<thead><tr><th>{ p.T("field.name") }</th><th>{ p.T("db.engine") }</th><th>{ p.T("db.server") }</th><th>{ p.T("db.account") }</th><th>{ p.T("field.score") }</th><th>{ p.T("db.schedule") }</th><th>{ p.T("db.last_scan") }</th></tr></thead>
						<tbody>
							for _, v := range list {
								<tr>
									<td><a class="strong" href={ templ.SafeURL(p.OrgURL("/databases/" + v.Conn.ID.String())) }>{ v.Conn.Name }</a></td>
									<td>@dbEngine(v.Conn.Engine)</td>
									<td class="mono faint">{ v.Conn.Host }:{ strconv.Itoa(int(v.Conn.Port)) }/{ v.Conn.DatabaseName }</td>
									<td>@dbConnStatus(p, v.Conn.Status)</td>
									<td>
										if v.Last != nil && v.Last.Score != nil {
											<span class="score">
												<span class="num">{ ScoreText(v.Last.Score) }</span>
												<span class="bar"><span class={ "fill " + ScoreBar(v.Last.Score) }></span></span>
												if v.Last.Grade != "" {
													<span class={ "grade", "grade-" + v.Last.Grade }>{ v.Last.Grade }</span>
												}
											</span>
										} else {
											<span class="faint">—</span>
										}
									</td>
									<td class="faint">{ p.ScheduleText(&v.Conn) }</td>
									<td class="faint">
										if v.Last != nil {
											<a href={ templ.SafeURL(p.OrgURL("/databases/scans/" + v.Last.ID.String())) }>{ Ago(v.Last.QueuedAt) }</a>
										} else {
											—
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
	}
}

// dbReadOnlyHelp shows how to create a read-only account per engine.
templ dbReadOnlyHelp(p *Page, engine string) {
	<section class="panel">
		<div class="panel-head">
			<span class="panel-icon">@Icon("lock")</span>
			<div><h2>{ p.T("db.ro_title") }</h2><p class="muted">{ p.T("db.ro_sub") }</p></div>
		</div>
		for _, e := range []string{dbscan.EnginePostgres, dbscan.EngineMySQL, dbscan.EngineMSSQL} {
			<div class="ro-help" data-engine-help={ e } hidden?={ engine != "" && engine != e }>
				<h3>@dbEngine(e)</h3>
				<p class="muted">{ p.T("db.ro." + e) }</p>
				<div class="secret-box copyable sql">
					<pre>{ roSQL(e) }</pre>
					<button type="button" class="btn small" data-copy={ roSQL(e) }>⧉</button>
				</div>
			</div>
		}
		<p class="faint">{ p.T("db.ro_note") }</p>
	</section>
}

// DBConnForm adds or edits a connection.
templ DBConnForm(p *Page, f *Form, d *service.DBConnDetail, mod service.OrgModule) {
	@AppShell(p) {
		if d == nil {
			@pageHero(p, "database", p.T("db.new"), p.T("db.new_sub"), p.T("db.title"), p.T("db.new"))
		} else {
			@pageHero(p, "edit", p.T("db.edit"), d.Conn.Name, p.T("db.title"), d.Conn.Name, p.T("db.edit"))
		}
		<div class="grid cols-2 db-form">
			<section class="card">
				@formErr(p, f)
				<form method="post" class="stack" autocomplete="off">
					@csrf(p)
					<div class="field">
						<label for="name">{ p.T("field.name") }</label>
						<input type="text" id="name" name="name" value={ f.V("name") } required maxlength="100" placeholder="ERP production"/>
						@fieldErr(p, f, "name")
					</div>
					<div class="row">
						<div class="field">
							<label for="engine">{ p.T("db.engine") }</label>
							<select id="engine" name="engine" data-engine-select>
								for _, e := range []string{dbscan.EnginePostgres, dbscan.EngineMySQL, dbscan.EngineMSSQL} {
									<option value={ e } selected?={ f.V("engine") == e } data-port={ strconv.Itoa(dbscan.DefaultPort(e)) }>{ EngineLabel(e) }</option>
								}
							</select>
						</div>
						<div class="field">
							<label for="tls">{ p.T("db.tls") }</label>
							<select id="tls" name="tls">
								for _, t := range []string{"require", "verify", "disable"} {
									<option value={ t } selected?={ f.V("tls") == t }>{ p.T("db.tls." + t) }</option>
								}
							</select>
						</div>
					</div>
					<div class="row">
						<div class="field grow">
							<label for="host">{ p.T("db.host") }</label>
							<input type="text" id="host" name="host" value={ f.V("host") } required maxlength="253" placeholder="10.0.0.12 / db.internal" class="mono"/>
							@fieldErr(p, f, "host")
						</div>
						<div class="field narrow">
							<label for="port">{ p.T("db.port") }</label>
							<input type="number" id="port" name="port" value={ f.V("port") } min="1" max="65535" data-port-input placeholder={ strconv.Itoa(dbscan.DefaultPort(f.V("engine"))) }/>
							@fieldErr(p, f, "port")
						</div>
					</div>
					<div class="field">
						<label for="database">{ p.T("db.database") }</label>
						<input type="text" id="database" name="database" value={ f.V("database") } required maxlength="128" class="mono"/>
						@fieldErr(p, f, "database")
					</div>
					<div class="row">
						<div class="field">
							<label for="user">{ p.T("db.user") }</label>
							<input type="text" id="user" name="user" value={ f.V("user") } required maxlength="128" autocomplete="off" class="mono"/>
							@fieldErr(p, f, "user")
						</div>
						<div class="field">
							<label for="password">{ p.T("db.password") }</label>
							<input type="password" id="password" name="password" maxlength="1024" autocomplete="new-password" required?={ d == nil } placeholder={ passwordPlaceholder(p, d) }/>
							@fieldErr(p, f, "password")
						</div>
					</div>
					if d != nil {
						<p class="hint">{ p.T("db.password_edit_hint") }</p>
					}
					<div class="alert ok ro-banner">@Icon("lock") <span>{ p.T("db.ro_required") }</span></div>
					<h3>{ p.T("db.schedule") }</h3>
					if mod.Settings.NoSchedule {
						<p class="muted">{ p.T("db.schedule_disabled") }</p>
					} else {
						<div class="row">
							<div class="field">
								<label for="schedule">{ p.T("db.schedule") }</label>
								<select id="schedule" name="schedule">
									for _, s := range []string{"off", "hourly", "daily", "weekly"} {
										<option value={ s } selected?={ f.V("schedule") == s }>{ p.T("db.schedule." + s) }</option>
									}
								</select>
							</div>
							<div class="field">
								<label for="schedule_hour">{ p.T("db.schedule_hour") }</label>
								<select id="schedule_hour" name="schedule_hour">
									for h := 0; h < 24; h++ {
										<option value={ strconv.Itoa(h) } selected?={ f.V("schedule_hour") == strconv.Itoa(h) }>{ hourLabel(h) }</option>
									}
								</select>
							</div>
							<div class="field">
								<label for="schedule_weekday">{ p.T("db.schedule_weekday") }</label>
								<select id="schedule_weekday" name="schedule_weekday">
									for _, wd := range []int{1, 2, 3, 4, 5, 6, 0} {
										<option value={ strconv.Itoa(wd) } selected?={ f.V("schedule_weekday") == strconv.Itoa(wd) }>{ p.T("weekday." + strconv.Itoa(wd)) }</option>
									}
								</select>
							</div>
						</div>
					}
					<details class="field" open?={ f.V("exclude") != "" }>
						<summary>{ p.T("db.exclude") }</summary>
						<textarea name="exclude" rows="4" class="mono" placeholder="dbo.Temp*&#10;audit.*&#10;*_backup">{ f.V("exclude") }</textarea>
						<span class="hint">{ p.T("db.exclude_hint") }</span>
					</details>
					<div class="row inline">
						<button class="btn primary" type="submit">
							if d == nil {
								{ p.T("db.save_verify") }
							} else {
								{ p.T("action.save") }
							}
						</button>
						if d != nil {
							<a class="btn" href={ templ.SafeURL(p.OrgURL("/databases/" + d.Conn.ID.String())) }>{ p.T("action.cancel") }</a>
						} else {
							<a class="btn" href={ templ.SafeURL(p.OrgURL("/databases")) }>{ p.T("action.cancel") }</a>
						}
					</div>
				</form>
			</section>
			@dbReadOnlyHelp(p, f.V("engine"))
		</div>
	}
}

// DBConnDetail shows a connection: account check, schedule and scans.
// While the check or a scan runs the page refreshes itself.
templ DBConnDetail(p *Page, d *service.DBConnDetail) {
	@AppShell(p) {
		<div id="db-live" class="scan-page"
			if ConnBusy(d.Conn.Status) || d.Active != nil {
				hx-get={ p.Path }
				hx-trigger="every 3s"
				hx-select="#db-live"
				hx-swap="outerHTML"
			}
		>
			@pageHero(p, "database", d.Conn.Name, d.Conn.Host+":"+strconv.Itoa(int(d.Conn.Port))+" / "+d.Conn.DatabaseName, p.T("db.title"), d.Conn.Name) {
				if p.Can("scan.trigger") && d.Conn.Status == "ready" {
					<form method="post" action={ templ.SafeURL(p.OrgURL("/databases/" + d.Conn.ID.String() + "/scan")) }>
						@csrf(p)
						<button class="btn primary glow" type="submit" disabled?={ d.Active != nil }>@Icon("play")<span>{ p.T("scans.scan_now") }</span></button>
					</form>
				}
				if p.Can("project.write") {
					<form method="post" action={ templ.SafeURL(p.OrgURL("/databases/" + d.Conn.ID.String() + "/verify")) }>
						@csrf(p)
						<button class="btn" type="submit" disabled?={ ConnBusy(d.Conn.Status) || d.Conn.PasswordEnc == nil }>@Icon("refresh")<span>{ p.T("db.reverify") }</span></button>
					</form>
					<a class="btn" href={ templ.SafeURL(p.OrgURL("/databases/" + d.Conn.ID.String() + "/edit")) }>@Icon("edit")<span>{ p.T("action.edit") }</span></a>
				}
				if p.Can("project.delete") {
					<form method="post" action={ templ.SafeURL(p.OrgURL("/databases/" + d.Conn.ID.String() + "/delete")) } hx-confirm={ p.T("db.delete_confirm") }>
						@csrf(p)
						<button class="btn danger" type="submit">@Icon("trash")</button>
					</form>
				}
			}
			<div class="grid cols-2">
				@dbVerifyCard(p, d)
				<section class="card">
					<h2>{ p.T("db.details") }</h2>
					<table class="kv">
						<tr><th>{ p.T("db.engine") }</th><td>@dbEngine(d.Conn.Engine)</td></tr>
						<tr><th>{ p.T("db.server") }</th><td class="mono">{ d.Conn.Host }:{ strconv.Itoa(int(d.Conn.Port)) }</td></tr>
						<tr><th>{ p.T("db.database") }</th><td class="mono">{ d.Conn.DatabaseName }</td></tr>
						<tr><th>{ p.T("db.user") }</th><td class="mono">{ d.Conn.Username }</td></tr>
						<tr><th>{ p.T("db.tls") }</th><td>{ p.T("db.tls." + d.Conn.TlsMode) }</td></tr>
						<tr><th>{ p.T("db.schedule") }</th><td>{ p.ScheduleText(&d.Conn) }
							if d.Conn.NextRunAt != nil && d.Conn.Schedule != "off" {
								<span class="faint"> · { p.T("db.next_run") } { p.NextRunText(d.Conn.NextRunAt) }</span>
							}
						</td></tr>
						if len(d.Conn.Exclude) > 0 {
							<tr><th>{ p.T("db.exclude") }</th><td class="mono">{ strings.Join(d.Conn.Exclude, ", ") }</td></tr>
						}
						if d.Verify.Server != "" {
							<tr><th>{ p.T("db.server_version") }</th><td class="faint">{ d.Verify.Server }</td></tr>
						}
					</table>
				</section>
			</div>
			if d.Active != nil {
				<div class="alert"><span class="spinner"></span> { p.T("db.scan.running") } <a href={ templ.SafeURL(p.OrgURL("/databases/scans/" + d.Active.ID.String())) }>{ p.T("scan.open") }</a></div>
			}
			<section class="panel">
				<div class="panel-head">
					<span class="panel-icon">@Icon("activity")</span>
					<div><h2>{ p.T("scans.history") }</h2></div>
				</div>
				if len(d.Scans) == 0 {
					<p class="muted">{ p.T("db.no_scans") }</p>
				} else {
					<div class="tablewrap flat">
						<table class="data">
							<thead><tr><th>{ p.T("field.when") }</th><th>{ p.T("db.trigger") }</th><th>{ p.T("field.status") }</th><th>{ p.T("field.score") }</th><th>{ p.T("db.findings") }</th><th>{ p.T("scans.new_fixed") }</th></tr></thead>
							<tbody>
								for _, s := range d.Scans {
									<tr>
										<td><a class="strong" href={ templ.SafeURL(p.OrgURL("/databases/scans/" + s.ID.String())) }>{ s.QueuedAt.Local().Format("2006-01-02 15:04") }</a></td>
										<td class="faint">{ p.T("db.trigger." + s.Trigger) }</td>
										<td>@statusBadge(p, s.Status, s.GateResult)</td>
										<td>
											if s.Score != nil {
												<span class="score">
													<span class="num">{ ScoreText(s.Score) }</span>
													<span class="bar"><span class={ "fill " + ScoreBar(s.Score) }></span></span>
													<span class={ "grade", "grade-" + s.Grade }>{ s.Grade }</span>
												</span>
											} else {
												<span class="faint">—</span>
											}
										</td>
										<td>@dbCountChips(p, CountsOf(s.Counts))</td>
										<td><span class="delta up">+{ strconv.Itoa(int(s.NewFindings)) }</span> <span class="delta down">−{ strconv.Itoa(int(s.FixedFindings)) }</span></td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</section>
		</div>
	}
}

templ dbCountChips(p *Page, counts map[string]int) {
	<span class="sev-mini">
		for _, s := range []string{"high", "medium", "low"} {
			if counts[s] > 0 {
				<span class={ "sev", s }>{ strconv.Itoa(counts[s]) }</span>
			}
		}
		if counts["high"]+counts["medium"]+counts["low"] == 0 {
			<span class="faint">0</span>
		}
	</span>
}

// dbVerifyCard is the read-only check result.
templ dbVerifyCard(p *Page, d *service.DBConnDetail) {
	<section class={ "card", "verify-card", "vc-" + d.Conn.Status }>
		<h2>@Icon("lock") { p.T("db.verify_title") }</h2>
		switch d.Conn.Status {
			case "pending", "verifying":
				<p class="vc-state"><span class="spinner"></span> { p.T("db.verifying") }</p>
				<p class="muted">{ p.T("db.verifying_body") }</p>
			case "ready":
				<p class="vc-state ok">@Icon("shield-check") { p.T("db.verified_ok") }</p>
				if d.Verify.ReadOnly != nil {
					<p class="muted">{ p.T("db.verified_as", d.Verify.ReadOnly.User) }</p>
					<ul class="perm-list ok">
						for _, a := range d.Verify.ReadOnly.Allowed {
							<li>@Icon("check")<span>{ a }</span></li>
						}
					</ul>
				}
				if d.Conn.VerifiedAt != nil {
					<p class="faint">{ p.T("db.verified_at") } { d.Conn.VerifiedAt.Local().Format("2006-01-02 15:04") }</p>
				}
			case "rejected":
				<p class="vc-state bad">@Icon("alert-triangle") { p.T("db.rejected") }</p>
				<p class="muted">{ p.T("db.rejected_body") }</p>
				if d.Verify.ReadOnly != nil {
					<ul class="perm-list bad">
						for _, v := range d.Verify.ReadOnly.Violations {
							<li>@Icon("x")<span>{ v }</span></li>
						}
					</ul>
				}
				if p.Can("project.write") {
					<a class="btn primary" href={ templ.SafeURL(p.OrgURL("/databases/" + d.Conn.ID.String() + "/edit")) }>{ p.T("db.enter_readonly") }</a>
				}
			case "error":
				<p class="vc-state bad">@Icon("alert-circle") { p.T("db.verify_error") }</p>
				<p class="mono snippet-line">{ d.Verify.Error }</p>
				<p class="muted">{ p.T("db.error_hint." + errCode(d.Verify.Code)) }</p>
		}
	</section>
}

// DBScanReport is the result of one structure scan.
templ DBScanReport(p *Page, v *service.DBScanView, f DBFilter) {
	@AppShell(p) {
		<div id="db-live" class="scan-page"
			if DBScanBusy(v.Scan.Status) {
				hx-get={ p.Path }
				hx-trigger="every 3s"
				hx-select="#db-live"
				hx-swap="outerHTML"
			}
		>
			@pageHero(p, "database", p.T("db.report_title"), v.Conn.Name+" · "+EngineLabel(v.Conn.Engine)+" · "+v.Conn.DatabaseName, p.T("db.title"), v.Conn.Name, v.Scan.QueuedAt.Local().Format("2006-01-02 15:04")) {
				if v.Scan.Status == "completed" {
					<a class="btn" href={ templ.SafeURL(p.OrgURL("/databases/scans/" + v.Scan.ID.String() + "/export/csv")) } hx-boost="false">@Icon("download")<span>CSV</span></a>
					<a class="btn" href={ templ.SafeURL(p.OrgURL("/databases/scans/" + v.Scan.ID.String() + "/export/json")) } hx-boost="false">@Icon("download")<span>JSON</span></a>
				}
				if v.Scan.Status == "queued" && p.Can("scan.trigger") {
					<form method="post" action={ templ.SafeURL(p.OrgURL("/databases/scans/" + v.Scan.ID.String() + "/cancel")) }>
						@csrf(p)
						<button class="btn danger" type="submit">{ p.T("scan.cancel") }</button>
					</form>
				}
				<a class="btn" href={ templ.SafeURL(p.OrgURL("/databases/" + v.Conn.ID.String())) }>{ p.T("db.connection") }</a>
			}
			if DBScanBusy(v.Scan.Status) {
				<div class="alert"><span class="spinner"></span> { p.T("db.scan." + v.Scan.Status) }</div>
			}
			if v.Scan.Log != "" {
				<details class="card" open?={ DBScanBusy(v.Scan.Status) }>
					<summary><strong>{ p.T("scan.log") }</strong></summary>
					<div class="scanlog"><pre>{ v.Scan.Log }</pre></div>
				</details>
			}
			if v.Scan.Status == "failed" || v.Scan.Status == "canceled" {
				<div class="alert err"><strong>{ p.T("db.scan_failed") }</strong><p>{ v.Scan.StatusReason }</p></div>
			}
			if v.Scan.Status == "completed" {
				@dbSummary(p, v)
				@dbFindings(p, v, f)
			}
		</div>
	}
}

templ dbSummary(p *Page, v *service.DBScanView) {
	<div class="sum-tiles">
		<div class={ "sum-tile", "gate-" + Gate(v.Scan.GateResult) }>
			<span class="sum-icon">
				if Gate(v.Scan.GateResult) == "fail" {
					@Icon("alert-triangle")
				} else {
					@Icon("shield-check")
				}
			</span>
			<div>
				<div class="sum-label">{ p.T("scan.gate") }</div>
				<div class="sum-value">{ p.T("gate." + Gate(v.Scan.GateResult)) }</div>
				<div class="sum-sub">{ p.T("failon." + v.Summary.FailOn) }</div>
			</div>
		</div>
		<div class={ "sum-tile", "grade-" + v.Scan.Grade }>
			<span class="sum-icon">@Icon("gauge")</span>
			<div>
				<div class="sum-label">{ p.T("field.score") }</div>
				<div class="sum-value">{ ScoreText(v.Scan.Score) }<span class="faint">/100</span><span class="grade">{ v.Scan.Grade }</span></div>
			</div>
		</div>
		<div class="sum-tile">
			<span class="sum-icon">@Icon("database")</span>
			<div>
				<div class="sum-label">{ p.T("db.objects") }</div>
				<div class="sum-value">{ strconv.Itoa(v.Summary.Stats.Tables) }<span class="faint unit">{ p.T("db.tables_unit") }</span></div>
				<div class="sum-sub">{ p.T("db.objects_sub", v.Summary.Stats.Columns, v.Summary.Stats.Views, v.Summary.Stats.Routines) }</div>
			</div>
		</div>
		<div class="sum-tile">
			<span class="sum-icon">@Icon("activity")</span>
			<div>
				<div class="sum-label">{ p.T("scans.new_fixed") }</div>
				<div class="sum-value"><span class="delta up">+{ strconv.Itoa(int(v.Scan.NewFindings)) }</span> <span class="delta down">−{ strconv.Itoa(int(v.Scan.FixedFindings)) }</span></div>
				<div class="sum-sub">{ Duration(v.Scan.StartedAt, v.Scan.FinishedAt) }</div>
			</div>
		</div>
	</div>
	<div class="catscores">
		for _, c := range v.Summary.Categories {
			<div class="catscore">
				<div class="cs-head"><span>{ p.T("dbcat." + c.Category) }</span><strong>{ strconv.Itoa(c.Score) }</strong></div>
				<div class="bar"><span class={ "fill", ScoreClass(c.Score), BarClass(c.Score, true) }></span></div>
				<div class="faint">{ p.T("db.cat_findings", c.Findings) }</div>
			</div>
		}
		<div class="catscore">
			<div class="cs-head"><span>{ p.T("db.detected") }</span></div>
			<div class="faint">{ p.T("db.detected_tables") } <strong>{ dash(v.Summary.Stats.TableStyle) }</strong></div>
			<div class="faint">{ p.T("db.detected_columns") } <strong>{ dash(v.Summary.Stats.ColumnStyle) }</strong></div>
			<div class="faint">{ p.T("db.detected_number") } <strong>{ dash(v.Summary.Stats.TableNumber) }</strong></div>
		</div>
	</div>
	<div class="sev-tiles">
		for _, s := range []string{"critical", "high", "medium", "low", "info"} {
			<div class={ "sev-tile", s }><span>{ p.T("sev." + s) }</span><strong>{ strconv.Itoa(v.Counts[s]) }</strong></div>
		}
	</div>
	if v.Summary.Stats.Truncated {
		<div class="alert warn">{ p.T("db.truncated") }</div>
	}
}

templ dbFindings(p *Page, v *service.DBScanView, f DBFilter) {
	<section class="card">
		<div class="ib-head">
			<h2>{ p.T("db.findings") } <span class="faint">({ strconv.Itoa(len(v.Findings)) })</span></h2>
			<form method="get" class="ib-search mini-search">
				@Icon("search")
				for _, kv := range [][2]string{{"sev", f.Sev}, {"cat", f.Cat}, {"rule", f.Rule}} {
					if kv[1] != "" {
						<input type="hidden" name={ kv[0] } value={ kv[1] }/>
					}
				}
				<input type="search" name="q" value={ f.Q } placeholder={ p.T("db.search") } aria-label={ p.T("db.search") }/>
			</form>
		</div>
		<div class="facets">
			<div class="facet-row">
				<span class="facet-label">{ p.T("issues.facet.sev") }</span>
				for _, fc := range DBFacet(v, "sev", p.Path0(), f) {
					<a class={ "chip", "f-sev-" + fc.Value, templ.KV("active", fc.Active) } href={ templ.SafeURL(fc.URL) }>{ p.T("sev." + fc.Value) } <span class="n">{ strconv.Itoa(fc.Count) }</span></a>
				}
			</div>
			<div class="facet-row">
				<span class="facet-label">{ p.T("db.category") }</span>
				for _, fc := range DBFacet(v, "cat", p.Path0(), f) {
					<a class={ "chip", templ.KV("active", fc.Active) } href={ templ.SafeURL(fc.URL) }>{ p.T("dbcat." + fc.Value) } <span class="n">{ strconv.Itoa(fc.Count) }</span></a>
				}
				if v.Scan.NewFindings > 0 {
					<a class={ "chip", templ.KV("active", f.New) } href={ templ.SafeURL(f.Toggle(p.Path0(), "new", "1")) }>{ p.T("issues.new") } <span class="n">{ strconv.Itoa(int(v.Scan.NewFindings)) }</span></a>
				}
			</div>
			if f.Active() {
				<a class="linkbtn" href={ templ.SafeURL(p.Path0()) }>{ p.T("issues.clear_filters") }</a>
			}
		</div>
		if groups := DBGroups(v, f); len(groups) == 0 {
			<div class="empty"><span class="hero-icon">@Icon("shield-check")</span><p>{ p.T("db.no_findings") }</p></div>
		} else {
			<div class="rule-groups">
				for _, g := range groups {
					<details class="rule-group" open?={ len(groups) <= 3 }>
						<summary>
							@sevBadge(p, g.Severity)
							<span class="rg-title">{ p.T("dbrule." + g.Rule.ID + ".title") }</span>
							<span class="faint mono">{ g.Rule.ID }</span>
							<span class="badge count">×{ strconv.Itoa(len(g.Findings)) }</span>
							if g.New > 0 {
								<span class="badge new">+{ strconv.Itoa(g.New) } { p.T("issues.new") }</span>
							}
						</summary>
						<p class="rg-fix">@Icon("badge-check") <span>{ p.T("dbrule." + g.Rule.ID + ".fix") }</span></p>
						<ul class="rg-list">
							for _, x := range FirstN(g.Findings, MaxShown) {
								<li>
									<span class="mono rg-obj">{ p.DBObject(&x.Finding) }</span>
									<span class="rg-msg">{ p.DBMessage(&x.Finding) }</span>
									if x.IsNew {
										<span class="badge new">{ p.T("issues.new") }</span>
									}
									if len(x.Details) > 0 {
										<ul class="rg-details">
											for _, dl := range x.Details {
												<li class="mono">{ dl }</li>
											}
										</ul>
									}
								</li>
							}
						</ul>
						if len(g.Findings) > MaxShown {
							<p class="faint">{ p.T("db.more_findings", len(g.Findings)-MaxShown) } <a href={ templ.SafeURL(f.Toggle(p.Path0(), "rule", g.Rule.ID)) }>{ p.T("db.show_all") }</a></p>
						}
					</details>
				}
			</div>
		}
	</section>
	if v.ReadOnly != nil {
		<details class="card">
			<summary><strong>@Icon("lock") { p.T("db.ro_evidence") }</strong></summary>
			<p class="muted">{ p.T("db.verified_as", v.ReadOnly.User) }</p>
			<ul class="perm-list ok">
				for _, a := range v.ReadOnly.Allowed {
					<li>@Icon("check")<span>{ a }</span></li>
				}
			</ul>
		</details>
	}
}

// DBRules edits the organization's rule profile.
templ DBRules(p *Page, f *Form, prof dbscan.Profile) {
	@AppShell(p) {
		@pageHero(p, "settings", p.T("db.rules"), p.T("db.rules_sub"), p.T("db.title"), p.T("db.rules"))
		@formErr(p, f)
		<form method="post" class="stack">
			@csrf(p)
			<fieldset class="unstyled" disabled?={ !p.Can("org.update") }>
				<div class="grid cols-2">
					<section class="card">
						<h2>{ p.T("db.rules_naming") }</h2>
						<div class="field">
							<label for="language">{ p.T("db.opt.language") }</label>
							<select id="language" name="language">
								for _, o := range []string{"en", "tr", "any"} {
									<option value={ o } selected?={ ProfileValue(prof, "language") == o }>{ p.T("db.opt.language." + o) }</option>
								}
							</select>
							<span class="hint">{ p.T("db.opt.language_hint") }</span>
						</div>
						<div class="row">
							for _, key := range []string{"table_case", "column_case"} {
								<div class="field">
									<label for={ key }>{ p.T("db.opt." + key) }</label>
									<select id={ key } name={ key }>
										for _, o := range []string{"auto", "snake", "pascal", "camel", "upper_snake"} {
											<option value={ o } selected?={ ProfileValue(prof, key) == o }>{ p.T("db.case." + o) }</option>
										}
									</select>
								</div>
							}
						</div>
						<div class="row">
							<div class="field">
								<label for="table_number">{ p.T("db.opt.table_number") }</label>
								<select id="table_number" name="table_number">
									for _, o := range []string{"auto", "plural", "singular", "any"} {
										<option value={ o } selected?={ ProfileValue(prof, "table_number") == o }>{ p.T("db.number." + o) }</option>
									}
								</select>
							</div>
							<div class="field">
								<label for="max_name_length">{ p.T("db.opt.max_name_length") }</label>
								<input type="number" id="max_name_length" name="max_name_length" min="10" max="128" value={ ProfileValue(prof, "max_name_length") }/>
							</div>
						</div>
					</section>
					<section class="card">
						<h2>{ p.T("db.rules_structure") }</h2>
						<div class="row">
							<div class="field">
								<label for="max_columns">{ p.T("db.opt.max_columns") }</label>
								<input type="number" id="max_columns" name="max_columns" min="5" max="1000" value={ ProfileValue(prof, "max_columns") }/>
							</div>
							<div class="field">
								<label for="fail_on">{ p.T("scan.gate") }</label>
								<select id="fail_on" name="fail_on">
									for _, o := range []string{"high", "medium", "low", "none"} {
										<option value={ o } selected?={ ProfileValue(prof, "fail_on") == o }>{ p.T("failon." + o) }</option>
									}
								</select>
							</div>
						</div>
						<label class="check"><input type="checkbox" name="require_audit" checked?={ RequireAudit(prof) }/> { p.T("db.opt.require_audit") }</label>
						<h3>{ p.T("db.opt.audit_names") }</h3>
						<p class="hint">{ p.T("db.opt.audit_names_hint") }</p>
						<div class="audit-grid">
							for _, c := range dbscan.AuditConcepts {
								<div class="field">
									<label for={ "audit_" + c }>{ p.T("dbconcept." + c) }</label>
									<input type="text" id={ "audit_" + c } name={ "audit_" + c } value={ ProfileValue(prof, "audit_"+c) } placeholder={ p.T("db.opt.auto") } maxlength="64" class="mono"/>
								</div>
							}
						</div>
					</section>
				</div>
				<section class="card">
					<h2>{ p.T("db.exclude") }</h2>
					<textarea name="exclude" rows="4" class="mono" placeholder="dbo.Temp*&#10;audit.*">{ ProfileValue(prof, "exclude") }</textarea>
					<span class="hint">{ p.T("db.exclude_org_hint") } { strings.Join(dbscan.DefaultExcludes[:8], ", ") } …</span>
				</section>
				<section class="card">
					<h2>{ p.T("db.rules_list") }</h2>
					<div class="tablewrap flat">
						<table class="data rules-table">
							<thead><tr><th>{ p.T("db.rule_on") }</th><th>{ p.T("db.rule") }</th><th>{ p.T("db.category") }</th><th>{ p.T("field.severity") }</th></tr></thead>
							<tbody>
								for i := range dbscan.Rules {
									@dbRuleRow(p, prof, &dbscan.Rules[i])
								}
							</tbody>
						</table>
					</div>
				</section>
				if p.Can("org.update") {
					<div><button class="btn primary" type="submit">{ p.T("action.save") }</button></div>
				} else {
					<p class="muted">{ p.T("db.rules_readonly") }</p>
				}
			</fieldset>
		</form>
	}
}

templ dbRuleRow(p *Page, prof dbscan.Profile, r *dbscan.RuleInfo) {
	{{ on, sev := RuleSetting(prof, r) }}
	<tr>
		<td><input type="checkbox" name={ "rule_" + r.ID } checked?={ on } aria-label={ r.ID }/></td>
		<td>
			<strong>{ p.T("dbrule." + r.ID + ".title") }</strong> <span class="faint mono">{ r.ID }</span>
			<div class="faint">{ p.T("dbrule." + r.ID + ".fix") }</div>
		</td>
		<td class="faint">{ p.T("dbcat." + r.Category) }</td>
		<td>
			<select name={ "sev_" + r.ID } aria-label={ p.T("field.severity") }>
				for _, s := range []string{"high", "medium", "low", "info"} {
					<option value={ s } selected?={ sev == s }>{ p.T("sev." + s) }</option>
				}
			</select>
		</td>
	</tr>
}

// AdminOrg lets the instance admin choose an organization's modules.
templ AdminOrg(p *Page, row service.OrgModulesRow) {
	@AppShell(p) {
		@pageHero(p, "building", row.Org.Name, p.T("admin.org_sub"), p.T("nav.instance"), p.T("nav.admin"), row.Org.Name)
		<form method="post" action={ templ.SafeURL("/admin/orgs/" + row.Org.ID.String() + "/modules") } class="stack">
			@csrf(p)
			<div class="grid cols-2">
				for _, m := range service.AllModules {
					@adminModuleCard(p, m, row.Modules[m])
				}
			</div>
			<div><button class="btn primary" type="submit">{ p.T("action.save") }</button></div>
		</form>
	}
}

templ adminModuleCard(p *Page, m string, om service.OrgModule) {
	<section class={ "card", "module-card", templ.KV("off", !om.Enabled) }>
		<div class="module-head">
			<span class="panel-icon">
				if m == "db" {
					@Icon("database")
				} else {
					@Icon("folder")
				}
			</span>
			<div>
				<h2>{ p.T("module." + m) }</h2>
				<p class="muted">{ p.T("module." + m + ".desc") }</p>
			</div>
			<label class="switch"><input type="checkbox" name={ m + "_enabled" } checked?={ om.Enabled }/><span>{ p.T("module.enabled") }</span></label>
		</div>
		<div class="field">
			<label for={ m + "_max" }>{ p.T("module." + m + ".max") }</label>
			<input type="number" id={ m + "_max" } name={ m + "_max" } min="0" max="100000" value={ strconv.Itoa(om.Settings.MaxItems) }/>
			<span class="hint">{ p.T("module.max_hint") }</span>
		</div>
		<label class="check"><input type="checkbox" name={ m + "_admins_only" } checked?={ om.Settings.AdminsOnly }/> { p.T("module.admins_only") }</label>
		<label class="check"><input type="checkbox" name={ m + "_no_schedule" } checked?={ om.Settings.NoSchedule }/> { p.T("module.no_schedule") }</label>
		<label class="check"><input type="checkbox" name={ m + "_no_notifications" } checked?={ om.Settings.NoNotifications }/> { p.T("module.no_notifications") }</label>
	</section>
}
