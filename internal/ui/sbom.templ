package ui

import (
	"net/url"
	"strconv"
	"strings"

	"github.com/ininia/scanx/internal/service"
)

// SBOM is the software inventory and vulnerability monitor page.
templ SBOM(p *Page, v *service.SBOMOverview, tab string) {
	@AppShell(p) {
		<div id="sbom-live" class="scan-page"
			if v.LastRun != nil && (v.LastRun.Status == "queued" || v.LastRun.Status == "running") {
				hx-get={ p.Path }
				hx-trigger="every 5s"
				hx-select="#sbom-live"
				hx-swap="outerHTML"
			}
		>
			@pageHero(p, "list", p.T("sbom.title"), p.T("sbom.subtitle"), p.T("nav.dashboard"), p.T("sbom.title")) {
				<a class="btn" href={ templ.SafeURL(p.OrgURL("/sbom/export/inventory")) } hx-boost="false">@Icon("download")<span>{ p.T("sbom.export_inventory") }</span></a>
				if p.Can("scan.trigger") {
					<form method="post" action={ templ.SafeURL(p.OrgURL("/sbom/check")) }>
						@csrf(p)
						<button class="btn primary glow" type="submit" disabled?={ v.LastRun != nil && (v.LastRun.Status == "queued" || v.LastRun.Status == "running") }>@Icon("refresh")<span>{ p.T("sbom.check_now") }</span></button>
					</form>
				}
			}
			if v.LastRun != nil && (v.LastRun.Status == "queued" || v.LastRun.Status == "running") {
				<div class="alert"><span class="spinner"></span> { p.T("sbom.running") }</div>
			}
			<div class="sum-tiles">
				<div class="sum-tile">
					<span class="sum-icon">@Icon("list")</span>
					<div>
						<div class="sum-label">{ p.T("sbom.components") }</div>
						<div class="sum-value">{ strconv.FormatInt(v.Stats.Components, 10) }</div>
						<div class="sum-sub">{ p.T("sbom.packages_projects", v.Stats.Packages, v.Stats.Projects) }</div>
					</div>
				</div>
				<div class={ "sum-tile", templ.KV("gate-fail", v.Counts["critical"]+v.Counts["high"] > 0) }>
					<span class="sum-icon">@Icon("alert-triangle")</span>
					<div>
						<div class="sum-label">{ p.T("sbom.open") }</div>
						<div class="sum-value">{ strconv.Itoa(len(v.Open)) }</div>
						<div class="sum-sub">{ p.T("sbom.crit_high", v.Counts["critical"], v.Counts["high"]) }</div>
					</div>
				</div>
				<div class="sum-tile">
					<span class="sum-icon">@Icon("shield-check")</span>
					<div>
						<div class="sum-label">{ p.T("sbom.resolved30") }</div>
						<div class="sum-value">{ strconv.Itoa(len(v.Resolved)) }</div>
					</div>
				</div>
				<div class="sum-tile">
					<span class="sum-icon">@Icon("clock")</span>
					<div>
						<div class="sum-label">{ p.T("sbom.last_run") }</div>
						if v.LastRun != nil && v.LastRun.FinishedAt != nil {
							<div class="sum-value small">{ Ago(*v.LastRun.FinishedAt) }</div>
							<div class="sum-sub">{ p.T("sbom.advisories", v.LastRun.Advisories) }</div>
						} else {
							<div class="sum-value small">—</div>
						}
					</div>
				</div>
			</div>
			<section class="card">
				<div class="ib-head">
					<div class="tabs">
						for _, t := range []string{"vulns", "components", "licenses", "resolved"} {
							<a class={ "chip", templ.KV("active", tab == t) } href={ templ.SafeURL(p.OrgURL("/sbom?tab=" + t)) }>{ p.T("sbom.tab." + t) }</a>
						}
					</div>
					<form method="get" class="ib-search mini-search">
						@Icon("search")
						<input type="search" name="q" value={ v.Query } placeholder={ p.T("sbom.search") } aria-label={ p.T("sbom.search") }/>
					</form>
				</div>
				switch tab {
					case "components":
						@sbomComponents(p, v)
					case "licenses":
						@sbomLicenses(p, v)
					case "resolved":
						@sbomResolved(p, v)
					default:
						@sbomVulns(p, v)
				}
			</section>
			if v.LastRun != nil && v.LastRun.Log != "" {
				<details class="card">
					<summary><strong>{ p.T("sbom.run_log") }</strong></summary>
					<div class="scanlog"><pre>{ v.LastRun.Log }</pre></div>
				</details>
			}
		</div>
	}
}

// sbomHelp explains what a tab lists and what to do about it.
templ sbomHelp(p *Page, key string) {
	<div class="help-box">
		@Icon("alert-circle")
		<div>{ p.T(key) }</div>
	</div>
}

// sbomPkg shows the package with its current version on its own line.
templ sbomPkg(p *Page, name, version, eco string) {
	<div class="mono strong">{ name }</div>
	<div class="faint">{ p.T("sbom.current") }: <span class="mono">{ version }</span></div>
	<div class="faint small">{ eco }</div>
}

templ sbomVulns(p *Page, v *service.SBOMOverview) {
	@sbomHelp(p, "sbom.help.vulns")
	if len(v.Open) == 0 {
		<div class="empty"><span class="hero-icon">@Icon("shield-check")</span><p>{ p.T("sbom.no_vulns") }</p></div>
	} else {
		<div class="row inline end"><a class="linkbtn" href={ templ.SafeURL(p.OrgURL("/sbom/export/vulns")) } hx-boost="false">{ p.T("sbom.export_vulns") }</a></div>
		<div class="tablewrap flat">
			<table class="data">
				<thead><tr><th>{ p.T("field.severity") }</th><th>{ p.T("sbom.advisory") }</th><th>{ p.T("sbom.package") }</th><th>{ p.T("sbom.fixed") }</th><th>{ p.T("field.project") }</th><th>{ p.T("sbom.first_seen") }</th></tr></thead>
				<tbody>
					for _, m := range v.Open {
						<tr>
							<td>@sevBadge(p, m.Severity)</td>
							<td>
								<a class="mono strong" href={ templ.URL("https://osv.dev/vulnerability/" + m.VulnID) } target="_blank" rel="noopener noreferrer">{ m.VulnID }</a>
								if m.Cve != "" && m.Cve != m.VulnID {
									<div class="mono faint">{ m.Cve }</div>
								}
								<div class="faint">{ m.Summary }</div>
							</td>
							<td>@sbomPkg(p, m.Name, m.Version, m.Ecosystem)</td>
							<td>
								if m.FixedVersion != "" {
									<div class="mono strong">{ m.FixedVersion }</div>
									<div class="faint small">{ p.T("sbom.upgrade_hint") }</div>
								} else {
									<div class="faint">{ p.T("sbom.no_fix") }</div>
									<div class="faint small">{ p.T("sbom.no_fix_hint") }</div>
								}
							</td>
							<td><a href={ templ.SafeURL(p.OrgURL("/projects/" + m.ProjectSlug)) }>{ m.ProjectName }</a></td>
							<td class="faint">{ Ago(m.FirstSeenAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ sbomComponents(p *Page, v *service.SBOMOverview) {
	@sbomHelp(p, "sbom.help.components")
	if v.Query != "" {
		<p class="muted">
			if lic, ok := strings.CutPrefix(v.Query, "license:"); ok {
				{ p.T("sbom.with_license", lic) }
			} else {
				{ p.T("search.for", v.Query) }
			}
			· { strconv.Itoa(len(v.Search)) }
			· <a href={ templ.SafeURL(p.OrgURL("/sbom?tab=components")) }>{ p.T("sbom.clear_search") }</a>
		</p>
		<div class="tablewrap flat">
			<table class="data">
				<thead><tr><th>{ p.T("sbom.package") }</th><th>{ p.T("sbom.license") }</th><th>{ p.T("field.project") }</th></tr></thead>
				<tbody>
					for _, c := range v.Search {
						<tr>
							<td>@sbomPkg(p, c.Name, c.Version, c.Ecosystem)</td>
							<td>
								if len(c.Licenses) == 0 {
									<span class={ LicBadge("unknown") }>{ p.T("sbom.lic.unknown") }</span>
								}
								for _, l := range c.Licenses {
									<div><span class="mono">{ l }</span> <span class={ LicBadge(LicClass(l)) }>{ p.T("sbom.lic." + LicClass(l)) }</span></div>
								}
							</td>
							<td><a href={ templ.SafeURL(p.OrgURL("/projects/" + c.ProjectSlug)) }>{ c.ProjectName }</a></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	} else {
		<div class="tablewrap flat">
			<table class="data">
				<thead><tr><th>{ p.T("sbom.package") }</th><th>{ p.T("sbom.ecosystem") }</th><th>{ p.T("sbom.projects") }</th><th>{ p.T("sbom.versions") }</th></tr></thead>
				<tbody>
					for _, t := range v.Top {
						<tr>
							<td class="mono"><a href={ templ.SafeURL(p.OrgURL("/sbom?q=" + url.QueryEscape(t.Name))) }>{ t.Name }</a></td>
							<td>
								<div>{ t.Ecosystem }</div>
								if d := p.EcoInfo(t.Ecosystem); d != "" {
									<div class="faint small">{ d }</div>
								}
							</td>
							<td>{ strconv.FormatInt(t.Projects, 10) }</td>
							<td>
								<div>{ strconv.FormatInt(t.Versions, 10) }</div>
								if t.Versions > 1 {
									<div class="faint small">{ p.T("sbom.versions_mixed") }</div>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ sbomLicenses(p *Page, v *service.SBOMOverview) {
	@sbomHelp(p, "sbom.help.licenses")
	<div class="tablewrap flat">
		<table class="data">
			<thead><tr><th>{ p.T("sbom.license") }</th><th>{ p.T("sbom.lic_risk") }</th><th>{ p.T("sbom.components") }</th><th>{ p.T("sbom.projects") }</th><th></th></tr></thead>
			<tbody>
				for _, l := range v.Licenses {
					{{ class := LicClass(l.License) }}
					<tr>
						<td class="lic-cell">
							<div><span class="mono strong">{ l.License }</span> <span class={ LicBadge(class) }>{ p.T("sbom.lic." + class) }</span></div>
							if d := p.LicInfo(l.License); d != "" {
								<div class="faint small">{ d }</div>
							}
						</td>
						<td class="lic-cell">
							<div>{ p.T("sbom.licrisk." + class) }</div>
							<div class="faint small"><strong>{ p.T("sbom.what_to_do") }</strong> { p.T("sbom.licfix." + class) }</div>
						</td>
						<td>{ strconv.FormatInt(l.Components, 10) }</td>
						<td>{ strconv.FormatInt(l.Projects, 10) }</td>
						<td><a class="linkbtn" href={ templ.SafeURL(p.OrgURL("/sbom?tab=components&q=" + url.QueryEscape("license:"+l.License))) }>{ p.T("sbom.show_packages") }</a></td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ sbomResolved(p *Page, v *service.SBOMOverview) {
	@sbomHelp(p, "sbom.help.resolved")
	if len(v.Resolved) == 0 {
		<p class="muted">{ p.T("sbom.none_resolved") }</p>
	} else {
		<div class="tablewrap flat">
			<table class="data">
				<thead><tr><th>{ p.T("field.severity") }</th><th>{ p.T("sbom.advisory") }</th><th>{ p.T("sbom.package") }</th><th>{ p.T("field.project") }</th><th>{ p.T("sbom.resolved_at") }</th></tr></thead>
				<tbody>
					for _, m := range v.Resolved {
						<tr>
							<td>@sevBadge(p, m.Severity)</td>
							<td class="mono">{ m.VulnID }</td>
							<td>
								<div class="mono strong">{ m.Name }</div>
								<div class="faint">{ p.T("sbom.was_version") }: <span class="mono">{ m.Version }</span></div>
							</td>
							<td>{ m.ProjectName }</td>
							<td class="faint">
								if m.ResolvedAt != nil {
									{ Ago(*m.ResolvedAt) }
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
