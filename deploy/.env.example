# scanX deployment settings. Copy to deploy/.env and append generated secrets:
#   docker run --rm ghcr.io/ininia/scanx:dev gen-secrets >> deploy/.env
# NEVER commit deploy/.env. Back up SCANX_MASTER_KEY: losing it makes stored
# deploy keys undecryptable.

SCANX_VERSION=dev
SCANX_DOMAIN=localhost
SCANX_BASE_URL=https://localhost
SCANX_HTTP_PORT=80
SCANX_HTTPS_PORT=443
SCANX_LOG_LEVEL=info

# --- scanning (worker) ---
# Scans run one at a time by default; each scan may use this much memory.
# Server RAM needed ≈ 1.5 GB + concurrency × SCANX_SCANNER_MEMORY.
SCANX_WORKER_CONCURRENCY=1
SCANX_SCANNER_MEMORY=3g
SCANX_SCANNER_CPUS=2
SCANX_SCAN_TIMEOUT=30m
# Allow repositories on private/internal networks (self-hosted GitLab/Gitea):
SCANX_ALLOW_PRIVATE_GIT_HOSTS=false
# SSH host keys of self-hosted Git servers (output of: ssh-keyscan git.example.com),
# several lines separated by \n. github.com, gitlab.com, bitbucket.org and
# codeberg.org are built in.
# SCANX_SSH_KNOWN_HOSTS=

# --- e-mail notifications (optional) ---
# SCANX_SMTP_HOST=smtp.example.com
# SCANX_SMTP_PORT=587
# SCANX_SMTP_USERNAME=
# SCANX_SMTP_PASSWORD=
# SCANX_SMTP_FROM=scanx@example.com
# SCANX_SMTP_TLS=starttls
SCANX_LOG_FORMAT=json

# --- generated secrets (scanx gen-secrets) go below ---
